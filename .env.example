# Choose exactly api or html. API requires the token; HTML requires only its one start URL.
TOURNAMENT_SOURCE=api
# API-only endpoint; never send TOURNAMENT_API_TOKEN to HTML.
TOURNAMENT_API_BASE_URL=https://api.tournament.io/v1/public
TOURNAMENT_API_TOKEN=
# HTML-only single discovery start URL; unused in api mode.
TOURNAMENT_HTML_URL=
# GORM/SQLite database and scheduler/HTTP behavior.
DB_PATH=./data/tournaments.db
CRAWL_INTERVAL=15m
HTTP_TIMEOUT=30s
PAGE_LIMIT=25
MAX_RETRIES=3
RETRY_BACKOFF=1s
LOG_LEVEL=info
# React admin UI is disabled by default; credentials are required only when enabled.
ADMIN_UI_ENABLED=false
ADMIN_BIND_ADDR=127.0.0.1:8081
ADMIN_USERNAME=
ADMIN_PASSWORD=
